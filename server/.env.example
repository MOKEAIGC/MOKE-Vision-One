# === Infinite Canvas Backend Configuration ===

# API Provider Settings
# Supported protocols: openai, apimart, gemini, volcengine, runninghub
API_PROVIDER_ID=default
API_PROVIDER_NAME=Default
API_BASE_URL=https://api.openai.com
API_KEY=
API_PROTOCOL=openai

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ModelScope (阿里魔搭)
MODELSCOPE_TOKEN=

# ComfyUI Instances (JSON array)
# Example: [{"url":"http://127.0.0.1:8188","name":"Local"}]
COMFYUI_INSTANCES=[]

# APIMart
APIMART_BASE_URL=
APIMART_API_KEY=

# Volcengine (火山引擎)
VOLCENGINE_BASE_URL=
VOLCENGINE_API_KEY=

# RunningHub
RUNNINGHUB_BASE_URL=
RUNNINGHUB_API_KEY=

# Server
SERVER_PORT=3002
SERVER_HOST=0.0.0.0
