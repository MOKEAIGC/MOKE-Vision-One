{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOKE Vision One",
  "mainBinaryName": "moke-vision-one",
  "version": "../package.json",
  "identifier": "ai.rytesa.moke-vision-one",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "devCsp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "MOKE Vision One · 虚拟量子相机",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "focus": true,
        "backgroundColor": "#050505"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "Photography",
    "publisher": "MOKE",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}