# =========================================================
# MOKE Vision One · 环境变量样例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
# 这里列出的所有字段都是**可选**的——客户端运行时可由用户在 UI 中填入，
# 环境变量仅用于 CI / 自动化测试 / 开发自托管场景。
# =========================================================

# ---------- Google Gemini 官方 API（可选）----------
# 仅 CI/自动化场景下使用；生产用户 App 里由用户在设置面板输入
VITE_GEMINI_API_KEY=
VITE_GEMINI_BASE_URL=

# ---------- 云雾 AI 中转（可选）----------
VITE_YUNWU_API_KEY=
VITE_YUNWU_BASE_URL=https://yunwu.ai

# ---------- 应用行为开关 ----------
# 生产打包请保持为 false，避免 DevTools 暴露密钥
VITE_ENABLE_DEVTOOLS=false

# ---------- Electron 代码签名（仅打包时用，不会进客户端）----------
# macOS
# CSC_LINK=                    # .p12 证书文件路径或 base64
# CSC_KEY_PASSWORD=            # .p12 证书密码
# APPLE_ID=                    # Apple ID 邮箱（公证用）
# APPLE_APP_SPECIFIC_PASSWORD= # App 专用密码
# APPLE_TEAM_ID=               # 开发者团队 ID

# Windows（可选签名）
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
