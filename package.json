{
  "name": "moke-vision-one",
  "productName": "MOKE Vision One",
  "private": true,
  "version": "3.7.3",
  "description": "虚拟量子相机 — AI 图像生成桌面应用",
  "author": "MOKE",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "release:artifacts": "node scripts/package-tauri-release.mjs",
    "release:verify": "node scripts/package-tauri-release.mjs --require-all",
    "release:full:win:x64": "npm run tauri:build:win:x64 && npm run release:artifacts",
    "release:full:mac:x64": "npm run tauri:build:mac:x64 && npm run release:artifacts",
    "release:full:mac:arm64": "npm run tauri:build:mac:arm64 && npm run release:artifacts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@google/genai": "^1.36.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jszip": "3.10.1",
    "leaflet": "^1.9.4",
    "lit": "^3.3.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.19.0",
    "marked": "^17.0.6",
    "marked-highlight": "^2.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
